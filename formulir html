 <!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Formulir Permintaan Layanan | PT Deboro Lentera Nusantara</title>
  <meta name="description" content="Hubungi PT Deboro Lentera Nusantara untuk permintaan layanan tenaga kerja.">
  <style>
    :root { color-scheme: light; --navy:#15324b; --gold:#c69b45; --ink:#243444; --muted:#667788; --line:#d9e1e8; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui,-apple-system,Segoe UI,Roboto,sans-serif; background:#f3f6f8; color:var(--ink); }
    header { background:var(--navy); color:white; padding:30px 20px; border-bottom:5px solid var(--gold); }
    .wrap { max-width:760px; margin:auto; }
    header h1 { margin:0 0 8px; font-size:clamp(1.4rem,4vw,2rem); }
    header p { margin:0; color:#e2eaf0; }
    main { padding:28px 16px 48px; }
    form,.notice { background:white; border:1px solid var(--line); border-radius:16px; padding:clamp(18px,4vw,30px); box-shadow:0 8px 24px #17324b0b; }
    .intro { margin:0 0 22px; color:var(--muted); line-height:1.55; }
    .field { margin:0 0 18px; }
    label { display:block; font-weight:650; margin-bottom:7px; }
    input,select,textarea { width:100%; border:1px solid #bcc9d4; border-radius:9px; padding:12px 13px; font:inherit; background:#fff; color:var(--ink); }
    input:focus,select:focus,textarea:focus { outline:3px solid #c69b453d; border-color:var(--gold); }
    textarea { min-height:120px; resize:vertical; }
    .help { color:var(--muted); font-size:.88rem; margin-top:6px; }
    button { border:0; border-radius:10px; padding:13px 18px; background:var(--navy); color:#fff; font:inherit; font-weight:700; cursor:pointer; width:100%; }
    button:disabled { opacity:.65; cursor:wait; }
    #status { margin-top:16px; line-height:1.5; }
    .success { color:#176b42; } .error { color:#a12727; }
    footer { color:var(--muted); text-align:center; font-size:.85rem; padding:0 16px 30px; }
    /* Honeypot anti-spam field: hidden from people and keyboard navigation. */
    .hp { position:absolute !important; left:-10000px !important; width:1px !important; height:1px !important; overflow:hidden !important; }
  </style>
</head>
<body>
  <header><div class="wrap">
    <h1>PT Deboro Lentera Nusantara</h1>
    <p>Formulir permintaan informasi dan layanan</p>
  </div></header>
  <main class="wrap">
    <form id="inquiry-form">
      <p class="intro">Isi formulir berikut. Tim kami dapat menghubungi Anda melalui nomor telepon yang dicantumkan.</p>
      <div class="field"><label for="customer_name">Nama lengkap *</label><input id="customer_name" name="customer_name" autocomplete="name" maxlength="100" required minlength="2"></div>
      <div class="field"><label for="phone">Nomor telepon/WhatsApp *</label><input id="phone" name="phone" autocomplete="tel" type="tel" maxlength="30" placeholder="Contoh: 081234567890" required></div>
      <div class="field"><label for="email">Email (opsional)</label><input id="email" name="email" autocomplete="email" type="email" maxlength="254" placeholder="nama@email.com"></div>
      <div class="field"><label for="requested_service_id">Layanan yang dibutuhkan</label><select id="requested_service_id" name="requested_service_id"><option value="">Memuat daftar layanan…</option></select><div class="help" id="service-help">Pilih layanan yang sesuai dengan kebutuhan Anda.</div></div>
      <div class="field"><label for="message">Keterangan kebutuhan (opsional)</label><textarea id="message" name="message" maxlength="2000" placeholder="Ceritakan kebutuhan Anda secara singkat."></textarea><div class="help">Maksimal 2.000 karakter. Jangan cantumkan data sensitif yang tidak diperlukan.</div></div>
      <div class="hp" aria-hidden="true"><label for="website">Biarkan kolom ini kosong</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>
      <button id="submit-btn" type="submit">Kirim Permintaan</button>
      <div id="status" role="status" aria-live="polite"></div>
    </form>
  </main>
  <footer>PT Deboro Lentera Nusantara · Data digunakan untuk menindaklanjuti permintaan Anda.</footer>
<script>
  // Isi kedua nilai ini setelah membuat proyek Supabase dan deploy Edge Function.
  const SUPABASE_URL = "https://PROJECT-REF.supabase.co";
  const SUPABASE_ANON_KEY = "PASTE_SUPABASE_PUBLISHABLE_OR_ANON_KEY_DI_SINI";
  const FUNCTION_URL = `${SUPABASE_URL}/functions/v1/submit-inquiry`;

  const form = document.getElementById('inquiry-form');
  const select = document.getElementById('requested_service_id');
  const statusBox = document.getElementById('status');
  const submitBtn = document.getElementById('submit-btn');

  function showStatus(message, type) {
    statusBox.textContent = message;
    statusBox.className = type || '';
  }

  async function loadServices() {
    select.innerHTML = '<option value="">Tidak memilih / belum tahu</option>';
    try {
      const response = await fetch(FUNCTION_URL, {
        method: 'GET',
        headers: { 'apikey': SUPABASE_ANON_KEY }
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Daftar layanan tidak tersedia.');
      for (const service of result.services || []) {
        const option = document.createElement('option');
        option.value = service.id;
        option.textContent = service.service_name;
        select.appendChild(option);
      }
    } catch (error) {
      document.getElementById('service-help').textContent = 'Daftar layanan gagal dimuat. Anda tetap bisa mengirim formulir tanpa memilih layanan.';
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    showStatus('', '');
    if (!form.reportValidity()) return;
    if (SUPABASE_URL.includes('PROJECT-REF') || SUPABASE_ANON_KEY.includes('PASTE_')) {
      showStatus('Konfigurasi belum selesai. Isi SUPABASE_URL dan SUPABASE_ANON_KEY di bagian script index.html.', 'error');
      return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = 'Mengirim…';
    const payload = {
      customer_name: form.customer_name.value.trim(),
      phone: form.phone.value.trim(),
      email: form.email.value.trim(),
      requested_service_id: select.value,
      message: form.message.value.trim(),
      website: form.website.value.trim()
    };
    try {
      const response = await fetch(FUNCTION_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': SUPABASE_ANON_KEY },
        body: JSON.stringify(payload)
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Permintaan gagal dikirim. Silakan coba kembali.');
      showStatus(result.message || 'Terima kasih. Permintaan Anda berhasil dikirim.', 'success');
      form.reset();
    } catch (error) {
      showStatus(error.message || 'Koneksi gagal. Periksa internet dan coba lagi.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Kirim Permintaan';
    }
  });

  loadServices();
</script>
</body>
</html>
